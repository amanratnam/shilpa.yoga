# Site
NEXT_PUBLIC_SITE_URL="https://shilpa.yoga"

# Resend (transactional email for contact / enquiry forms)
# Without RESEND_API_KEY, forms still work in dev but no email is sent.
RESEND_API_KEY=""
RESEND_FROM="Shilpa Yoga Space <hello@shilpa.yoga>"
CONTACT_TO="hello@shilpa.yoga"

# Razorpay (scaffolded — test keys in build, production keys deferred to launch)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
