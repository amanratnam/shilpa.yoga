# Site
NEXT_PUBLIC_SITE_URL="https://www.shilpa.yoga"

# Resend (transactional email for the contact / enquiry form)
# Without RESEND_API_KEY the form still works in dev but no email is sent.
RESEND_API_KEY=""
RESEND_FROM="Shilpa Yoga Space <namaste@shilpa.yoga>"
# Comma-separated recipients.
CONTACT_TO="namaste@shilpa.yoga,aman.ratnam.singh@gmail.com"

# Admin panel (/admin)
# Credentials default to shilpa / admin when unset.
ADMIN_USERNAME="shilpa"
ADMIN_PASSWORD="admin"
# Required. Signs the admin session cookie. Generate with:
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Supabase, backing the admin client list.
# Run supabase/001_clients.sql once to create the table.
SUPABASE_URL="https://aofcqupyahbyybpdizzw.supabase.co"
# Service-role key. Server-only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
